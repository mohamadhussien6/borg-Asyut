root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
[*.cs]
indent_style = space
indent_size = 4
[*.{json,asmdef}]
indent_style = space
indent_size = 2
# Unity may serialize empty YAML fields with a trailing space.
[*.{unity,prefab,asset,meta,physicsMaterial2D}]
trim_trailing_whitespace = false
